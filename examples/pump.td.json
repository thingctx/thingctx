{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    {
      "tc": "https://thingctx.dev/vocab#",
      "saref": "https://saref.etsi.org/core/",
      "om": "http://www.ontology-of-units-of-measure.org/resource/om-2/"
    }
  ],
  "id": "urn:demo:pump:v1",
  "title": "Pump",
  "titles": { "en": "Pump", "de": "Pumpe" },
  "@type": ["saref:Actuator", "saref:Sensor"],
  "description": "A demo pump, published by the device and loaded by the demos. It is the coverage exemplar, exercising the full WoT TD 1.1 surface across four transports (local/http/mqtt/sse): metadata and i18n, the full form vocabulary, typed properties/actions/events with the async-action and event lifecycle schemas, Thing-level bulk forms, and every security scheme variant.",
  "support": "mailto:ops@thingctx.dev",
  "created": "2025-01-01T00:00:00Z",
  "modified": "2025-03-12T00:00:00Z",
  "version": { "instance": "1.2.0", "model": "1.0.0" },
  "base": "{BASE_URL}/",
  "profile": ["https://www.w3.org/TR/wot-profile/"],
  "schemaDefinitions": {
    "rpmValue": { "type": "integer", "minimum": 0, "maximum": 6000 },
    "errorResponse": {
      "type": "object",
      "properties": { "error": { "type": "string" } }
    }
  },
  "uriVariables": {
    "id": { "type": "string", "description": "A sensor id (Thing-level uriVariable)." }
  },
  "links": [
    { "href": "https://thingctx.dev/pump/manual.pdf", "rel": "alternate", "type": "application/pdf" }
  ],
  "securityDefinitions": {
    "bearer_sc": { "scheme": "bearer", "in": "header", "alg": "ES256", "format": "jwt" },
    "basic_sc": { "scheme": "basic", "in": "header" },
    "digest_sc": { "scheme": "digest", "in": "header", "qop": "auth" },
    "apikey_sc": { "scheme": "apikey", "in": "header", "name": "X-API-Key" },
    "oauth2_sc": {
      "scheme": "oauth2",
      "flow": "client_credentials",
      "token": "https://auth.thingctx.dev/token",
      "scopes": ["read", "write"]
    },
    "psk_sc": { "scheme": "psk", "identity": "pump-v1" },
    "auto_sc": { "scheme": "auto" },
    "any_sc": { "scheme": "combo", "oneOf": ["bearer_sc", "basic_sc"] },
    "all_sc": { "scheme": "combo", "allOf": ["basic_sc", "apikey_sc"] }
  },
  "security": ["bearer_sc"],
  "forms": [
    { "href": "all/properties", "op": ["readallproperties", "readmultipleproperties"] },
    { "href": "all/properties", "op": ["writeallproperties", "writemultipleproperties"] },
    {
      "href": "all/events",
      "op": ["subscribeallevents"],
      "subprotocol": "sse",
      "security": ["oauth2_sc"],
      "scopes": ["read"]
    }
  ],
  "actions": {
    "diagnose": {
      "@type": "tc:PromptTemplate",
      "description": "A prompt template to diagnose the pump (the WoT-native equivalent of an MCP prompt, via the tc: extension vocabulary). The template lives in the TD, so it expands client-side; no device call.",
      "input": {
        "type": "object",
        "properties": {
          "severity": { "type": "string", "description": "low | high" }
        },
        "required": ["severity"]
      },
      "output": { "type": "array" },
      "tc:template": "Severity {severity}: read the pump status, list any sensor reading over its limit, and say whether the pump is healthy.",
      "forms": [{ "href": "local://diagnose" }]
    },
    "set_speed": {
      "@type": "saref:ActuatingFunction",
      "description": "Set the pump speed (rpm).",
      "synchronous": true,
      "input": {
        "type": "object",
        "properties": { "rpm": { "type": "integer" } },
        "required": ["rpm"]
      },
      "output": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "rpm": { "type": "integer" }
        }
      },
      "forms": [{ "href": "local://set_speed" }]
    },
    "status": {
      "description": "Read the pump status.",
      "input": { "type": "object", "properties": {} },
      "idempotent": true,
      "safe": true,
      "synchronous": true,
      "output": {
        "type": "object",
        "properties": {
          "rpm": { "type": "integer" },
          "temp": { "type": "number" },
          "healthy": { "type": "boolean" }
        }
      },
      "forms": [
        {
          "href": "status",
          "contentType": "application/json",
          "contentCoding": "gzip",
          "response": { "contentType": "application/json" },
          "additionalResponses": [
            {
              "success": false,
              "contentType": "application/json",
              "schema": "errorResponse",
              "htv:statusCodeNumber": 503
            }
          ]
        }
      ]
    },
    "read_sensor": {
      "description": "Read one named sensor by id (id goes in the URL path).",
      "input": {
        "type": "object",
        "properties": { "id": { "type": "string" } },
        "required": ["id"]
      },
      "safe": true,
      "idempotent": true,
      "uriVariables": { "id": { "type": "string" } },
      "forms": [{ "href": "sensors/{id}" }]
    },
    "estop": {
      "description": "Emergency stop. Args: reason (string).",
      "input": {
        "type": "object",
        "properties": { "reason": { "type": "string" } }
      },
      "forms": [{ "href": "local://estop" }]
    },
    "calibrate": {
      "description": "Calibrate the pump toward a target rpm (long-running).",
      "synchronous": false,
      "input": {
        "type": "object",
        "properties": { "target": { "type": "integer" } }
      },
      "output": {
        "type": "object",
        "properties": { "calibrated_to": { "type": "integer" } }
      },
      "forms": [
        { "href": "actions/calibrate", "op": ["invokeaction", "queryaction", "cancelaction"] }
      ]
    },
    "set_coolant": {
      "description": "Open or close the coolant valve (over the plant MQTT bus).",
      "input": {
        "type": "object",
        "properties": { "open": { "type": "boolean" } },
        "required": ["open"]
      },
      "output": {
        "type": "object",
        "properties": { "ok": { "type": "boolean" }, "coolant_open": { "type": "boolean" } }
      },
      "forms": [{ "href": "mqtt://{MQTT_BROKER}/pump/set_coolant" }]
    }
  },
  "properties": {
    "rpm": {
      "@type": "saref:Measurement",
      "type": "integer",
      "title": "RPM",
      "titles": { "en": "RPM", "de": "Drehzahl" },
      "description": "Current rpm (read-only gauge).",
      "readOnly": true,
      "observable": true,
      "unit": "om:revolutionPerMinute",
      "forms": [
        { "href": "local://rpm", "op": ["readproperty", "observeproperty", "unobserveproperty"] }
      ]
    },
    "target_rpm": {
      "type": "integer",
      "description": "Desired rpm setpoint (read AND write).",
      "forms": [
        { "href": "local://target_rpm", "op": ["readproperty", "writeproperty"] }
      ]
    },
    "camera": {
      "type": "string",
      "description": "Latest camera frame (a PNG; the warning light is red when over the limit).",
      "readOnly": true,
      "contentMediaType": "image/png",
      "forms": [
        { "href": "local://camera", "op": ["readproperty"], "contentType": "image/png" }
      ]
    }
  },
  "events": {
    "overheat": {
      "description": "Temperature exceeded the limit.",
      "subscription": {
        "type": "object",
        "properties": { "threshold": { "type": "number" } }
      },
      "data": {
        "type": "object",
        "properties": {
          "temp": { "type": "number" },
          "limit": { "type": "number" }
        }
      },
      "dataResponse": {
        "type": "object",
        "properties": { "ack": { "type": "boolean" } }
      },
      "cancellation": {
        "type": "object",
        "properties": { "reason": { "type": "string" } }
      },
      "forms": [
        {
          "href": "events/overheat",
          "op": ["subscribeevent", "unsubscribeevent"],
          "subprotocol": "sse"
        }
      ]
    }
  }
}
